#!/usr/bin/env bash
set -euo pipefail

# Never mutate files in pre-commit; fail fast with actionable messages.
git diff --cached --check

staged_go=()
while IFS= read -r f; do
  [[ -n "$f" ]] && staged_go+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.go')

if (( ${#staged_go[@]} > 0 )); then
  unformatted="$(gofmt -l "${staged_go[@]}")"
  if [[ -n "$unformatted" ]]; then
    echo "error: gofmt needed on staged Go files:" >&2
    printf '  %s\n' $unformatted >&2
    exit 1
  fi
fi

staged_sh=()
while IFS= read -r f; do
  [[ -n "$f" ]] && staged_sh+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACM -- 'scripts/*.sh' '.githooks/*')

if (( ${#staged_sh[@]} > 0 )); then
  for sf in "${staged_sh[@]}"; do
    bash -n "$sf"
  done
fi

if git diff --cached --name-only --diff-filter=ACM | grep -qx 'mygo.json'; then
  python3 -m json.tool mygo.json > /dev/null
fi
